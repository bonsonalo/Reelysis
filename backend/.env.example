# Copy to backend/.env and fill in. Never commit the real .env.
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
RUN_MIGRATIONS_ON_STARTUP=true
LOG_LEVEL=INFO

DB_URL=postgresql://postgres:postgres@localhost:5432/reelysis
REDIS_URL=redis://localhost:6379/0

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:8000/api/v1/instagram/oauth/callback

GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=
BRIGHT_DATA_API_KEY=
AI_MODEL_FLASH=gemini-2.5-flash
AI_MODEL_PRO=gemini-2.5-flash
# true = mock Gemini, AssemblyAI and Bright Data (no API costs)
AI_SIMULATION_MODE=true
GEMINI_DAILY_BUDGET=20
GEMINI_MAX_RPM=5

# Email (password reset + verification). Empty SMTP_HOST in development logs the links instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Reelysis <no-reply@reelysis.app>
SMTP_USE_TLS=true

# Celery beat: daily sync + Instagram token refresh
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_HOURS=24
# Free Render worker only: its public URL (e.g. https://reelysis-worker.onrender.com), set on the
# API and the worker so queued jobs wake it and running jobs keep it awake. Empty = off.
WORKER_WAKE_URL=

# Proxies in front of the API that append to X-Forwarded-For (Render = 1)
TRUSTED_PROXY_HOPS=1
